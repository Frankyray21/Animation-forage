 "fin_parole": 184.460091,
 "repliques": [
  {
   "ligne": 0,
   "passage": "A_intro",
   "orateur": 1,
   "texte": "À matin, on parle du démontage du cône d'un mandrin.",
   "reprise": 0.0,
   "fin_parole": 3.083968,
   "ecart_debut": 0.0,
   "ecart_fin": 0.096,
   "a_verifier": false
  },
  {
   "ligne": 1,
   "passage": "A_intro",
   "orateur": 2,
   "texte": "Avec les dix-huit ressorts comprimés en arrière, hein ?",
   "reprise": 3.743333,
   "fin_parole": 6.073628,
   "ecart_debut": -0.013,
   "ecart_fin": 0.126,
   "a_verifier": false
  },
  {
   "ligne": 2,
   "passage": "A_intro",
   "orateur": 1,
   "texte": "Exactement. Tant que le cône est boulonné, c'est de l'énergie emmagasinée.",
   "reprise": 6.783741,
   "fin_parole": 10.683288,
   "ecart_debut": -0.014,
   "ecart_fin": 0.117,
   "a_verifier": false
  },
  {
   "ligne": 3,
   "passage": "A_intro",
   "orateur": 2,
   "texte": "Correct. On regarde ça étape par étape.",
   "reprise": 11.362971,
   "fin_parole": 13.976689,
   "ecart_debut": 0.027,
   "ecart_fin": 0.143,
   "a_verifier": false
  },
  {
   "ligne": 4,
   "passage": "A_00_c",
   "orateur": 1,
   "texte": "Étape un : les manettes Clam et Chuck en position fermée.",
   "reprise": 15.489841,
   "fin_parole": 18.993288,
   "ecart_debut": 0.09,
   "ecart_fin": 0.107,
   "a_verifier": false
  },
  {
   "ligne": 5,
   "passage": "A_00_p",
   "orateur": 1,
   "texte": "Regardez la coupe : l'hydraulique est coupé, mais les ressorts verts sont encore comprimés. Fermer les manettes ne libère pas leur énergie.",
   "reprise": 20.081769,
   "fin_parole": 26.780068,
   "ecart_debut": 0.078,
   "ecart_fin": 0.09,
   "a_verifier": false
  },
  {
   "ligne": 6,
   "passage": "A_01_c",
   "orateur": 1,
   "texte": "Étape deux : on vérifie que les mâchoires, les jaws, sont fermées.",
   "reprise": 28.145125,
   "fin_parole": 31.992336,
   "ecart_debut": -0.015,
   "ecart_fin": -0.012,
   "a_verifier": false
  },
  {
   "ligne": 7,
   "passage": "A_02_c",
   "orateur": 1,
   "texte": "Étape trois : on cadenasse la foreuse. Le cadenas empêche de repartir l'hydraulique, mais les ressorts, eux, poussent encore.",
   "reprise": 33.384694,
   "fin_parole": 40.083741,
   "ecart_debut": 0.145,
   "ecart_fin": 0.006,
   "a_verifier": false
  },
  {
   "ligne": 8,
   "passage": "A_03_c",
   "orateur": 1,
   "texte": "Étape quatre : les trois boulons de trois quarts du couvert des mâchoires, avec la clé d'un pouce et un huitième.",
   "reprise": 41.425374,
   "fin_parole": 47.243107,
   "ecart_debut": -0.015,
   "ecart_fin": 0.097,
   "a_verifier": false
  },
  {
   "ligne": 9,
   "passage": "A_04_c",
   "orateur": 1,
   "texte": "Étape cinq : les neuf boulons d'un demi-pouce du couvercle, avec la clé de trois quarts.",
   "reprise": 49.784807,
   "fin_parole": 54.449025,
   "ecart_debut": 0.115,
   "ecart_fin": 0.071,
   "a_verifier": false
  },
  {
   "ligne": 10,
   "passage": "A_05_c",
   "orateur": 1,
   "texte": "Étape six, c'est la clé de toute la job : on remet les trois boulons longs, les bolts, sans bushing.",
   "reprise": 61.78737,
   "fin_parole": 67.700658,
   "ecart_debut": -0.017,
   "ecart_fin": 0.099,
   "a_verifier": false
  },
  {
   "ligne": 11,
   "passage": "A_05_p",
   "orateur": 1,
   "texte": "Sans bushing, ils vissent un pouce et demi plus loin. Assez de filets en prise pour retenir le cône si jamais il part.",
   "reprise": 68.618435,
   "fin_parole": 74.254172,
   "ecart_debut": 0.012,
   "ecart_fin": 0.066,
   "a_verifier": false
  },
  {
   "ligne": 12,
   "passage": "A_06_c",
   "orateur": 1,
   "texte": "Étape sept : les six boulons d'un demi-pouce par six pouces et demi. Un tour à la fois, dans l'ordre, de un à six. Regardez le compteur en haut à droite, pis la fenêtre en bas : à chaque tour, les ressorts s'allongent un peu.",
   "reprise": 75.569297,
   "fin_parole": 89.346803,
   "ecart_debut": -0.009,
   "ecart_fin": 0.033,
   "a_verifier": false
  },
  {
   "ligne": 13,
   "passage": "A_06_p",
   "orateur": 1,
   "texte": "Les six boulons partagent la charge : les ressorts se détendent peu à peu, également. C'est plus long, mais on reste en contrôle.",
   "reprise": 92.689524,
   "fin_parole": 99.058186,
   "ecart_debut": -0.03,
   "ecart_fin": 0.022,
   "a_verifier": false
  },
  {
   "ligne": 14,
   "passage": "A_07_c",
   "orateur": 1,
   "texte": "Étape huit : les ressorts sont détendus. On retire les trois boulons longs d'un demi-pouce par huit pouces.",
   "reprise": 101.705964,
   "fin_parole": 107.551587,
   "ecart_debut": -0.036,
   "ecart_fin": 0.048,
   "a_verifier": false
  },
  {
   "ligne": 15,
   "passage": "A_07_p",
   "orateur": 1,
   "texte": "On les garde pour la fin parce qu'ils retiennent le cône jusqu'au bout. Maintenant, ils ne portent plus rien.",
   "reprise": 108.429274,
   "fin_parole": 113.362472,
   "ecart_debut": 0.021,
   "ecart_fin": 0.088,
   "a_verifier": false
  },
  {
   "ligne": 16,
   "passage": "A_08_c",
   "orateur": 1,
   "texte": "Étape neuf : on sort le cône, le bowl, pis les mâchoires, et on change les pièces. L'énergie a été relâchée lentement : le cône est resté retenu tout le long.",
   "reprise": 114.705079,
   "fin_parole": 123.800998,
   "ecart_debut": 0.145,
   "ecart_fin": 0.129,
   "a_verifier": false
  },
  {
   "ligne": 17,
   "passage": "A_fin",
   "orateur": 1,
   "texte": "Pour le quart : jamais un boulon du cône enlevé au complet sous charge. Les trois boulons longs sans bushing, avant l'étape sept. Pis un tour à la fois.",
   "reprise": 125.69517,
   "fin_parole": 135.206463,
   "ecart_debut": -0.015,
   "ecart_fin": -0.026,
   "a_verifier": false
  },
  {
   "ligne": 18,
   "passage": "A_questions",
   "orateur": 2,
   "texte": "Pis si un boulon veut pas se défaire ?",
   "reprise": 137.011927,
   "fin_parole": 138.876349,
   "ecart_debut": 0.008,
   "ecart_fin": 0.054,
   "a_verifier": false
  },
  {
   "ligne": 19,
   "passage": "A_questions",
   "orateur": 1,
   "texte": "On force pas à l'impact drill sous charge. On arrête, pis on en parle au superviseur avant de continuer.",
   "reprise": 139.723605,
   "fin_parole": 144.899274,
   "ecart_debut": 0.096,
   "ecart_fin": 0.091,
   "a_verifier": false
  },
  {
   "ligne": 20,
   "passage": "A_questions",
   "orateur": 2,
   "texte": "Pendant que je dévisse, je me place où ?",
   "reprise": 146.437596,
   "fin_parole": 148.402222,
   "ecart_debut": -0.008,
   "ecart_fin": 0.098,
   "a_verifier": false
  },
  {
   "ligne": 21,
   "passage": "A_questions",
   "orateur": 1,
   "texte": "Hors de l'axe du mandrin. Jamais devant le cône : s'il part, c'est là qu'il s'en va.",
   "reprise": 149.209932,
   "fin_parole": 153.983787,
   "ecart_debut": 0.17,
   "ecart_fin": 0.076,
   "a_verifier": false
  },
  {
   "ligne": 22,
   "passage": "A_questions",
   "orateur": 2,
   "texte": "Pis si le cône reste coincé ?",
   "reprise": 155.428594,
   "fin_parole": 156.999705,
   "ecart_debut": 0.231,
   "ecart_fin": 0.1,
   "a_verifier": false
  },
  {
   "ligne": 23,
   "passage": "A_questions",
   "orateur": 1,
   "texte": "On le frappe pas pour le décoincer, pis on reste pas devant. Les ressorts poussent encore : il peut être projeté.",
   "reprise": 157.898095,
   "fin_parole": 163.806961,
   "ecart_debut": 0.032,
   "ecart_fin": 0.063,
   "a_verifier": false
  },
  {
   "ligne": 24,
   "passage": "A_questions",
   "orateur": 2,
   "texte": "Si les boulons longs sont durs à remettre, on peut-tu sauter l'étape six ?",
   "reprise": 165.35932,
   "fin_parole": 169.37678,
   "ecart_debut": -0.039,
   "ecart_fin": 0.113,
   "a_verifier": false
  },
  {
   "ligne": 25,
   "passage": "A_questions",
   "orateur": 1,
   "texte": "Non. Ce sont eux qui retiennent le cône si quelque chose lâche. Sans eux, rien ne l'arrête.",
   "reprise": 170.174671,
   "fin_parole": 175.759546,
   "ecart_debut": 0.085,
   "ecart_fin": 0.08,
   "a_verifier": false
  },
  {
   "ligne": 26,
   "passage": "A_questions",
   "orateur": 2,
   "texte": "Pis si quelque chose me semble pas normal ?",
   "reprise": 177.257211,
   "fin_parole": 179.509002,
   "ecart_debut": 0.063,
   "ecart_fin": 0.111,
   "a_verifier": false
  },
  {
   "ligne": 27,
   "passage": "A_questions",
   "orateur": 1,
   "texte": "Tu arrêtes, pis tu en parles au superviseur. On regarde ça ensemble avant de continuer.",
   "reprise": 180.377029,
   "fin_parole": 184.460091,
   "ecart_debut": 0.023,
   "ecart_fin": 0.1,
   "a_verifier": false
  }
 ],
